<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 Генератор паролей + Усилитель | Приватный менеджер</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: radial-gradient(circle at 10% 20%, #0c0f1a, #070911);
            font-family: 'Segoe UI', 'Inter', system-ui, monospace;
            min-height: 100vh;
            padding: 2rem 1.5rem;
            color: #edf2ff;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .header h1 {
            font-size: 2rem;
            background: linear-gradient(115deg, #b7cdff, #6382f0);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .sub {
            color: #8f9bb5;
            margin-top: 8px;
        }

        /* две секции */
        .split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        @media (max-width: 780px) {
            .split {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: rgba(20, 25, 45, 0.7);
            backdrop-filter: blur(4px);
            border-radius: 2rem;
            padding: 1.8rem;
            border: 1px solid rgba(80, 110, 200, 0.3);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-bottom: 1.2rem;
            font-size: 1.5rem;
            display: flex;
            gap: 10px;
            align-items: center;
            border-left: 4px solid #5f7ef2;
            padding-left: 16px;
        }

        .option-group {
            margin: 18px 0;
        }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            margin: 12px 0;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        input[type="number"] {
            background: #0b0e18;
            border: 1px solid #2e3a60;
            padding: 10px 14px;
            border-radius: 20px;
            color: white;
            font-size: 1rem;
            width: 90px;
            text-align: center;
        }

        button {
            background: linear-gradient(95deg, #2c3f7c, #1b2550);
            border: none;
            padding: 12px 24px;
            border-radius: 40px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 12px;
            font-size: 0.9rem;
        }

        button:hover {
            transform: scale(1.02);
            background: #3f559b;
            box-shadow: 0 5px 12px rgba(0,0,0,0.3);
        }

        .password-output {
            background: #060812;
            padding: 16px;
            border-radius: 1.5rem;
            margin: 20px 0;
            font-family: monospace;
            font-size: 1.2rem;
            word-break: break-all;
            border: 1px solid #2f3a60;
            letter-spacing: 0.5px;
        }

        .strength {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: bold;
            margin-top: 8px;
        }

        .weak { background: #c44536; }
        .medium { background: #e6a017; }
        .strong { background: #2c8c5a; }

        hr {
            margin: 16px 0;
            border-color: #252c48;
        }

        .entropy {
            font-family: monospace;
            font-size: 0.8rem;
            background: #10131f;
            padding: 8px;
            border-radius: 18px;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>🔐 Генератор + Усилитель паролей</h1>
        <div class="sub">Локальный инструмент приватности — создавайте или усильте свои пароли без сервера</div>
    </div>

    <div class="split">
        <!-- ЛЕВАЯ СЕКЦИЯ: Генератор с нуля -->
        <div class="card">
            <h2>⚡ Генератор с нуля</h2>
            <div class="option-group">
                <label>Длина: <input type="number" id="length" min="6" max="64" value="16"></label>
            </div>
            <div class="checkbox-group">
                <label><input type="checkbox" id="useUpper" checked> A-Z (прописные)</label>
                <label><input type="checkbox" id="useLower" checked> a-z (строчные)</label>
                <label><input type="checkbox" id="useDigits" checked> 0-9 (цифры)</label>
                <label><input type="checkbox" id="useSymbols" checked> !@#$%^&*()_+-=[]{}</label>
            </div>
            <button id="generateBtn">🎲 Сгенерировать новый пароль</button>
            <div class="password-output" id="generatedPass">————————</div>
            <div id="genStrength"></div>
            <div class="entropy" id="genEntropy">Энтропия: — бит</div>
        </div>

        <!-- ПРАВАЯ СЕКЦИЯ: Усилитель пароля -->
        <div class="card">
            <h2>🔧 Усилитель пароля</h2>
            <p style="font-size:0.85rem; margin-bottom:10px;">Введите свой пароль — сделаем его сложнее, сохраняя основу</p>
            <input type="text" id="userPassword" placeholder="Ваш пароль..." style="width:100%; background:#0b0e18; border:1px solid #334066; padding:12px; border-radius: 28px; color:white; margin-bottom:12px;">
            <button id="strengthenBtn">⚡ Усилить пароль</button>
            <div class="password-output" id="strengthenedPass">————</div>
            <div id="strengthOrig"></div>
            <div class="entropy" id="strengthenEntropy">Энтропия: — бит</div>
            <hr>
            <div style="font-size:0.8rem; color:#a0b0dd;">💡 Усиление: leet-замены (a→@, e→3, i→1, o→0, s→5), добавление случайных цифр/символов в конец и середину.</div>
        </div>
    </div>
</div>

<script>
    // набор символов
    const uppercase = "ABCDEFGHJKLMNPQRSTUVWXYZ";
    const lowercase = "abcdefghijkmnopqrstuvwxyz";
    const digits = "23456789";
    const symbols = "!@#$%^&*()_+-=[]{}";

    function getCharSet() {
        let set = "";
        if (document.getElementById("useUpper").checked) set += uppercase;
        if (document.getElementById("useLower").checked) set += lowercase;
        if (document.getElementById("useDigits").checked) set += digits;
        if (document.getElementById("useSymbols").checked) set += symbols;
        if (set === "") return uppercase+lowercase;
        return set;
    }

    function generatePassword(length, charset) {
        let pwd = "";
        for (let i = 0; i < length; i++) {
            const rand = crypto.getRandomValues(new Uint32Array(1))[0] % charset.length;
            pwd += charset[rand];
        }
        return pwd;
    }

    function calculateEntropy(password, charsetSizeGuess = null) {
        let setSize = charsetSizeGuess;
        if (!setSize) {
            let hasLow = /[a-z]/.test(password);
            let hasUp = /[A-Z]/.test(password);
            let hasDig = /[0-9]/.test(password);
            let hasSym = /[^a-zA-Z0-9]/.test(password);
            let possible = 0;
            if (hasLow) possible += 26;
            if (hasUp) possible += 26;
            if (hasDig) possible += 10;
            if (hasSym) possible += 25;
            setSize = Math.max(possible, 2);
        }
        const entropyBits = Math.log2(Math.pow(setSize, password.length));
        return Math.floor(entropyBits);
    }

    function getStrengthLabel(entropy) {
        if (entropy < 40) return { text: "Слабый", class: "weak" };
        if (entropy < 60) return { text: "Средний", class: "medium" };
        return { text: "Сильный", class: "strong" };
    }

    function displayStrength(containerId, entropy, passwordText) {
        const container = document.getElementById(containerId);
        const strength = getStrengthLabel(entropy);
        container.innerHTML = `<span class="strength ${strength.class}">🔐 ${strength.text} (${entropy} бит)</span>`;
        if (passwordText && passwordText !== "————————" && entropy < 40) {
            container.innerHTML += `<span style="margin-left:10px; font-size:0.7rem;">⚠️ улучшите пароль</span>`;
        }
    }

    // генератор
    function refreshGenerator() {
        let len = parseInt(document.getElementById("length").value);
        if (isNaN(len)) len = 16;
        len = Math.min(64, Math.max(6, len));
        const charset = getCharSet();
        const newPwd = generatePassword(len, charset);
        document.getElementById("generatedPass").innerText = newPwd;
        const entropy = calculateEntropy(newPwd, charset.length);
        document.getElementById("genEntropy").innerHTML = `📊 Энтропия: ${entropy} бит`;
        displayStrength("genStrength", entropy, newPwd);
    }

    // УСИЛИТЕЛЬ: leet замены + рандомные символы
    function strengthenPassword(original) {
        if (!original || original.trim() === "") return "Введите пароль";
        let pwd = original;
        // leet-замены
        const leetMap = { 'a':'@', 'e':'3', 'i':'1', 'o':'0', 's':'5', 'A':'4', 'E':'3', 'I':'!', 'O':'0', 'S':'$' };
        for (let [key, val] of Object.entries(leetMap)) {
            pwd = pwd.split(key).join(val);
        }
        // добавим случайные цифры и символы в конец и между
        const randSymbols = "!@#$%^&*";
        const randDigits = "0123456789";
        const randomChar = (str) => str[crypto.getRandomValues(new Uint32Array(1))[0] % str.length];
        // добавим 2-4 спецсимвола или цифры
        let additions = "";
        const addLen = 2 + Math.floor(Math.random() * 3);
        for (let i=0; i<addLen; i++) {
            if (Math.random() > 0.5) additions += randomChar(randSymbols);
            else additions += randomChar(randDigits);
        }
        // вставка в середину
        const mid = Math.floor(pwd.length / 2);
        pwd = pwd.slice(0, mid) + randomChar(randSymbols) + randomChar(randDigits) + pwd.slice(mid);
        pwd = pwd + additions;
        // финальная обрезка до 40 символов, но не менее 12
        if (pwd.length > 45) pwd = pwd.slice(0, 45);
        return pwd;
    }

    function refreshStrengthener() {
        let input = document.getElementById("userPassword").value;
        if (!input) {
            document.getElementById("strengthenedPass").innerText = "⛔ введите пароль";
            document.getElementById("strengthenEntropy").innerHTML = "Энтропия: 0 бит";
            document.getElementById("strengthOrig").innerHTML = "";
            return;
        }
        const strengthened = strengthenPassword(input);
        document.getElementById("strengthenedPass").innerText = strengthened;
        const entropyStrong = calculateEntropy(strengthened);
        document.getElementById("strengthenEntropy").innerHTML = `📊 Энтропия усиленного: ${entropyStrong} бит`;
        displayStrength("strengthOrig", entropyStrong, strengthened);
        // также покажем исходную энтропию
        const origEntropy = calculateEntropy(input);
        document.getElementById("strengthOrig").innerHTML += `<div style="margin-top:6px; font-size:0.7rem;">🔍 Исходный пароль (без усиления): ~${origEntropy} бит</div>`;
    }

    document.getElementById("generateBtn").addEventListener("click", refreshGenerator);
    document.getElementById("strengthenBtn").addEventListener("click", () => {
        refreshStrengthener();
    });
    document.getElementById("userPassword").addEventListener("input", () => {
        // можно сбросить доп инфу
        document.getElementById("strengthOrig").innerHTML = "";
    });
    // инициализация
    refreshGenerator();
    window.addEventListener("load", () => {
        refreshGenerator();
    });
</script>
</body>
</html>
