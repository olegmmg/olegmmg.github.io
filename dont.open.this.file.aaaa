# /etc/cgtproxy/config.yaml

# Параметры прокси-сервера (ваш Happ)
tproxy:
  port: 12345           # Порт, который будет слушать cgtproxy
  ip: "127.0.0.1"       # Локальный адрес
  proxy_ip: "127.0.0.1" # Адрес вашего Happ прокси
  proxy_port: 10808     # Порт вашего SOCKS5 прокси от Happ

# --- Правила для управления трафиком ---
rules:
  # Использовать прокси для всех приложений по умолчанию?
  # 'proxy' - да, 'direct' - нет.
  default_action: "proxy"

  # Пользовательские исключения (опционально)
  exceptions:
    # Приложения, которые должны идти в обход прокси (например, свой банк)
    - match: { cmdline: "*банк*" }
      action: "direct"
    # Приложения, которые должны быть заблокированы
    - match: { cmdline: "*some_app*" }
      action: "drop"
